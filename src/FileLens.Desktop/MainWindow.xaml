<Window x:Class="FileLens.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:FileLens.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="FileLens — Local-First File Search &amp; Indexing Engine"
        Height="780" Width="1180"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="#F4F5F7"
        Foreground="#172B4D">

    <Window.Resources>
        <!-- Style shortcuts -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderBrush" Value="#DFE1E6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#C1C7D0" />
            <Setter Property="Background" Value="#F4F5F7" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#0052CC" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#0052CC" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Background" Value="#DE350B" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#DE350B" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top App Header -->
        <Border DockPanel.Dock="Top" Background="#0747A6" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="FileLens" FontSize="22" FontWeight="Bold" Foreground="White" />
                        <Border Background="#0052CC" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="PHASE 1" FontSize="11" FontWeight="Bold" Foreground="#DEEBFF" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Metadata Indexing &amp; Safe Job Engine • Windows Local-First Desktop" FontSize="12" Foreground="#B3D4FF" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Quick KPI Summary Header -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="16,0" HorizontalAlignment="Center">
                        <TextBlock Text="CONFIGURED ROOTS" FontSize="10" FontWeight="Bold" Foreground="#8EB8F7" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalRoots}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Separator Width="1" Height="28" Background="#2684FF" />
                    <StackPanel Margin="16,0" HorizontalAlignment="Center">
                        <TextBlock Text="INDEXED FILES" FontSize="10" FontWeight="Bold" Foreground="#8EB8F7" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalFilesIndexed}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Separator Width="1" Height="28" Background="#2684FF" />
                    <StackPanel Margin="16,0" HorizontalAlignment="Center">
                        <TextBlock Text="TOTAL SIZE" FontSize="10" FontWeight="Bold" Foreground="#8EB8F7" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalSizeDisplay}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" />
                    </StackPanel>
                    <Separator Width="1" Height="28" Background="#2684FF" />
                    <StackPanel Margin="16,0" HorizontalAlignment="Center">
                        <TextBlock Text="ERRORS" FontSize="10" FontWeight="Bold" Foreground="#FF8F73" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TotalErrors}" FontSize="18" FontWeight="Bold" Foreground="#FFAB00" HorizontalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Bottom Status Bar -->
        <StatusBar DockPanel.Dock="Bottom" Background="#EBECF0" Padding="8,4" BorderBrush="#DFFE1E6" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock x:Name="AiWorkerStatusText" Text="AI Worker: Checking..." FontSize="12" Foreground="#42526E" />
            </StatusBarItem>
            <Separator Width="1" Height="14" Margin="8,0" Background="#C1C7D0" />
            <StatusBarItem>
                <TextBlock Text="Database: SQLite (WAL Mode)" FontSize="12" Foreground="#42526E" />
            </StatusBarItem>
            <Separator Width="1" Height="14" Margin="8,0" Background="#C1C7D0" />
            <StatusBarItem>
                <TextBlock Text="{Binding JobStatusText, StringFormat='Job Engine: {0}'}" FontSize="12" FontWeight="SemiBold" Foreground="#0052CC" />
            </StatusBarItem>
        </StatusBar>

        <!-- Main Body Grid -->
        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*" MinWidth="420" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="5*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- LEFT PANE: Search Roots Management -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Add Location Card -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Add Search Location" FontSize="14" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,4" />
                        <TextBlock Text="Add local folders, drives (C:\), or authenticated UNC network shares (\\SERVER\Share):" FontSize="11" Foreground="#5E6C84" Margin="0,0,0,10" TextWrapping="Wrap" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Text="{Binding NewLocationPath, UpdateSourceTrigger=PropertyChanged}"
                                     Padding="8,6" FontSize="12" VerticalContentAlignment="Center"
                                     ToolTip="Enter a local directory or UNC network path (e.g., \\192.168.1.50\SharedDocs)" />

                            <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ActionButton}"
                                    Command="{Binding BrowseFolderCommand}" Margin="6,0,0,0" ToolTip="Browse for a local folder" />

                            <Button Grid.Column="2" Content="+ Add Location" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddLocationCommand}" Margin="6,0,0,0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Configured Locations Card -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Configured Search Roots" FontSize="14" FontWeight="Bold" Foreground="#172B4D" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Roots.Count, StringFormat=' ({0} total)'}" FontSize="12" Foreground="#6B778C" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Roots DataGrid -->
                        <DataGrid Grid.Row="2" ItemsSource="{Binding Roots}" SelectedItem="{Binding SelectedRoot}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" RowHeaderWidth="0" SelectionMode="Single"
                                  BorderBrush="#DFE1E6" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="55" />
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="120" />
                                <DataGridTextColumn Header="Files" Binding="{Binding FileCount}" Width="65" />
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusDisplay}" Width="80" />
                                <DataGridTextColumn Header="Last Scan" Binding="{Binding LastScanDisplay}" Width="135" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Bottom Root Action Bar -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                            <Button Content="Refresh List" Style="{StaticResource ActionButton}" Command="{Binding RefreshCommand}" />
                            <Button Content="Remove Selected" Style="{StaticResource DangerButton}" Command="{Binding RemoveLocationCommand}"
                                    ToolTip="Removes the root from FileLens. Physical files are NEVER deleted." />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT PANE: Indexing Job Engine & Real-Time Log -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Engine Control Card -->
                <Border Grid.Row="0" Style="{StaticResource CardPanel}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Indexing Job Engine" FontSize="14" FontWeight="Bold" Foreground="#172B4D" Margin="0,0,0,10" />

                        <!-- Job Action Controls -->
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Button Content="▶ Start Indexing" Style="{StaticResource PrimaryButton}" Command="{Binding StartIndexingCommand}" ToolTip="Start indexing all enabled roots or the selected root" />
                            <Button Content="⏸ Pause" Style="{StaticResource ActionButton}" Command="{Binding PauseIndexingCommand}" ToolTip="Pause active indexing" />
                            <Button Content="⏯ Resume" Style="{StaticResource ActionButton}" Command="{Binding ResumeIndexingCommand}" ToolTip="Resume paused indexing" />
                            <Button Content="⏹ Cancel" Style="{StaticResource DangerButton}" Command="{Binding CancelIndexingCommand}" ToolTip="Cancel active indexing jobs" />
                            <Button Content="🔄 Retry Failed" Style="{StaticResource ActionButton}" Command="{Binding RetryFailedCommand}" ToolTip="Retry roots with logged errors" />
                        </WrapPanel>

                        <!-- Progress Bar & Status -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding JobStatusText, StringFormat='Status: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#0052CC" />
                            <TextBlock Grid.Column="1" Text="{Binding ProgressPercent, StringFormat='{}{0:F0}%'}" FontSize="12" FontWeight="Bold" Foreground="#172B4D" />
                        </Grid>

                        <ProgressBar Height="10" Value="{Binding ProgressPercent}" IsIndeterminate="{Binding IsIndeterminate}" Minimum="0" Maximum="100" Margin="0,0,0,12" Background="#EBECF0" Foreground="#0052CC" />

                        <!-- Live Counters Grid -->
                        <UniformGrid Columns="4" Margin="0,0,0,10">
                            <Border Background="#F4F5F7" Padding="8,6" Margin="0,0,4,0" CornerRadius="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Discovered" FontSize="10" Foreground="#5E6C84" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding DiscoveredCount}" FontSize="14" FontWeight="Bold" Foreground="#172B4D" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#E3FCEF" Padding="8,6" Margin="2,0,2,0" CornerRadius="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Processed" FontSize="10" Foreground="#006644" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding ProcessedCount}" FontSize="14" FontWeight="Bold" Foreground="#006644" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFF0B3" Padding="8,6" Margin="2,0,2,0" CornerRadius="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Skipped" FontSize="10" Foreground="#172B4D" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding SkippedCount}" FontSize="14" FontWeight="Bold" Foreground="#172B4D" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FFEBE6" Padding="8,6" Margin="4,0,0,0" CornerRadius="4">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="Failed" FontSize="10" Foreground="#BF2600" HorizontalAlignment="Center" />
                                    <TextBlock Text="{Binding FailedCount}" FontSize="14" FontWeight="Bold" Foreground="#BF2600" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Current File Display -->
                        <TextBlock Text="{Binding CurrentDirectory, StringFormat='Folder: {0}'}" FontSize="11" Foreground="#6B778C" TextTrimming="CharacterEllipsis" Margin="0,2" />
                        <TextBlock Text="{Binding CurrentFile, StringFormat='File: {0}'}" FontSize="11" Foreground="#42526E" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>

                <!-- Activity Log Card -->
                <Border Grid.Row="2" Style="{StaticResource CardPanel}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Activity &amp; Diagnostics Log" FontSize="14" FontWeight="Bold" Foreground="#172B4D" />

                        <ListBox Grid.Row="2" ItemsSource="{Binding LogMessages}"
                                 FontFamily="Consolas, Cascadia Code, Courier New" FontSize="11"
                                 Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
